rules_version = '2';

// Tucker's Camp Lite — Firestore security rules
// Model: a small private camp. Every real user has a users/{uid} doc.
// - anyone signed in can READ member content (names, harvests, feed, calendar…)
// - you can only CREATE content as yourself, and DELETE only your own (or admin)
// - nobody can change their own role — admin only
// - the admin log is append-only

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid()      { return request.auth.uid; }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(uid()))
        && get(/databases/$(database)/documents/users/$(uid())).data.role == 'admin';
    }
    function ownsNew() { return signedIn() && request.resource.data.uid == uid(); }
    function ownsOld() { return signedIn() && resource.data.uid == uid(); }
    // The app itself (not a specific member) posts season-opener announcements
    // — no owner uid, any signed-in member's client may create one (the app
    // checks-and-creates by a deterministic doc id, so duplicates can't stick).
    function isSeasonAnnouncement() {
      return signedIn() && request.resource.data.type == 'season' && request.resource.data.uid == null;
    }
    // A non-owner may only touch the reactions map (read-modify-write for the
    // shared reaction UI) or bump the denormalized commentCount by exactly
    // ±1 (kept in sync with the comments subcollection below) — never the
    // post's own content. Comments themselves live in their own subcollection
    // (see the /comments match blocks) specifically so this can't be abused
    // to rewrite or delete someone else's reply — a shared array field can't
    // be validated element-by-element in rules, which is exactly the gap a
    // subcollection closes: each comment is its own document with its own
    // ownership check.
    function oldCommentCount() { return ('commentCount' in resource.data) ? resource.data.commentCount : 0; }
    function onlyReactionsOrCommentCount() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return signedIn()
        && affected.hasOnly(['reactions', 'commentCount'])
        && (!affected.hasAny(['commentCount'])
            || request.resource.data.commentCount == oldCommentCount() + 1
            || request.resource.data.commentCount == oldCommentCount() - 1);
    }

    // ---- sign-up config -------------------------------------------------
    // { codeHash, open } — public read so the Create Account form can check
    // the (hashed) camp code before anyone is authenticated. Admin-only write.
    match /config/{doc} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ---- member profiles ----------------------------------------------
    match /users/{userId} {
      allow read:   if signedIn();
      allow create: if uid() == userId
                    && request.resource.data.role == 'user';
      allow update: if isAdmin()
                    || (uid() == userId
                        && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // ---- member-authored content ------------------------------------
    // Reactions live on the parent doc (read-modify-write); comments are
    // their own subcollection (see /comments blocks below, right after each
    // parent match). A non-owner may update ONLY the reactions map or bump
    // commentCount by one (see onlyReactionsOrCommentCount) — the post's own
    // content can only be changed by its author or an admin. Create is
    // locked to the author; delete is author-or-admin.
    match /harvests/{id} {
      allow read:   if signedIn();
      allow create: if ownsNew();
      allow update: if ownsOld() || isAdmin() || onlyReactionsOrCommentCount();
      allow delete: if ownsOld() || isAdmin();
      // create allows admin too, not just ownsNew() — the one-time comments
      // migration writes each comment as its ORIGINAL author, run by an
      // admin, so the writer's uid and the comment's uid legitimately differ.
      match /comments/{commentId} {
        allow read:   if signedIn();
        allow create: if ownsNew() || isAdmin();
        allow update, delete: if ownsOld() || isAdmin();
      }
    }
    match /trailcam/{id} {
      allow read:   if signedIn();
      allow create: if ownsNew();
      allow update: if ownsOld() || isAdmin() || onlyReactionsOrCommentCount();
      allow delete: if ownsOld() || isAdmin();
      match /comments/{commentId} {
        allow read:   if signedIn();
        allow create: if ownsNew() || isAdmin();
        allow update, delete: if ownsOld() || isAdmin();
      }
    }
    match /trailcamAlbums/{id} {
      allow read:   if signedIn();
      allow create: if ownsNew();
      allow update: if ownsOld() || isAdmin();   // photo counts are bumped by the album's own uploader
      allow delete: if ownsOld() || isAdmin();
    }
    match /feed/{id} {
      allow read:   if signedIn();
      allow create: if ownsNew() || isSeasonAnnouncement();   // auto events carry the triggerer's uid; season posts don't
      allow update: if ownsOld() || isAdmin() || onlyReactionsOrCommentCount();
      allow delete: if isAdmin() || ownsOld();
      match /comments/{commentId} {
        allow read:   if signedIn();
        allow create: if ownsNew() || isAdmin();
        allow update, delete: if ownsOld() || isAdmin();
      }
    }

    // ---- calendar + contests ----------------------------------------
    match /visits/{id} {
      allow read:   if signedIn();
      allow create: if ownsNew();
      allow update: if ownsOld() || isAdmin();
      allow delete: if ownsOld() || isAdmin();
    }
    match /contestEntries/{id} {
      allow read:   if signedIn();
      allow create: if ownsNew();
      allow update: if ownsOld() || isAdmin();
      allow delete: if ownsOld() || isAdmin();
    }
    match /contestMeta/{id} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }

    // ---- admin-only --------------------------------------------------
    match /bulletins/{id} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }
    match /adminLog/{id} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;       // append-only, even for admins
    }

    // ---- legacy (guest keys removed) ------------------------------
    match /guestKeys/{id} {
      allow read, write: if isAdmin();
    }

    // ---- everything else is denied --------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
