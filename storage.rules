rules_version = '2';

// Tucker's Camp Lite — Storage rules
// Every upload embeds the uploader's uid as the filename's prefix
// ("<uid>_<timestamp>...", see app.js uploadBytes calls), so a delete can be
// checked against the actual uploader without extra metadata.

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function ownsFile(name) {
      return signedIn() && name.matches(request.auth.uid + '_.*');
    }

    function validImage() {
      return request.resource.size < 25 * 1024 * 1024
             && request.resource.contentType.matches('image/.*');
    }

    // Read/create — any signed-in member, image files under 25 MB. New files
    // only: this does NOT cover overwriting a path that already has a file —
    // see the per-folder rules below, which require the uploader (or admin)
    // for that. Without this split, anyone signed in could silently replace
    // another member's already-uploaded photo at its known filename.
    match /{allPaths=**} {
      allow read:   if signedIn();
      allow create: if signedIn() && validImage();
    }

    // Update (overwrite) and delete — only the uploader (by filename prefix) or an admin.
    match /feed/{file} {
      allow update: if (ownsFile(file) || isAdmin()) && validImage();
      allow delete: if ownsFile(file) || isAdmin();
    }
    match /harvests/{date}/{file} {
      allow update: if (ownsFile(file) || isAdmin()) && validImage();
      allow delete: if ownsFile(file) || isAdmin();
    }
    match /trailcam/{date}/{file} {
      allow update: if (ownsFile(file) || isAdmin()) && validImage();
      allow delete: if ownsFile(file) || isAdmin();
    }
  }
}
